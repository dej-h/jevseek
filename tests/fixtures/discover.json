{
  "openapi": "3.1.0",
  "info": { "title": "Discovery fixture", "version": "1" },
  "servers": [{ "url": "https://example.test" }],
  "paths": {
    "/pulls/{number}/comments": {
      "get": {
        "summary": "List pull request comments",
        "responses": { "200": { "description": "Comments" } }
      }
    },
    "/pulls/{number}/files": {
      "parameters": [{ "name": "number", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": {
        "operationId": "listFiles",
        "summary": "List changed files",
        "responses": {
          "200": {
            "description": "Changed files",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Files" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Files": {
        "type": "array",
        "items": { "type": "object", "properties": { "filename": { "type": "string" }, "status": { "type": "string" } } }
      }
    }
  }
}
